# QuestForge AI Production Environment Configuration
# Copy to .env.production and fill in values for production deployment

# Node Environment
NODE_ENV=production

# API Configuration
PORT=4000
API_URL=https://api.questforge.example.com
FRONTEND_URL=https://questforge.example.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@db.host:5432/questforge_prod
DB_POOL_SIZE=20

# Blockchain - Celo Network
# For Alfajores testnet:
RPC_URL_ALFAJORES=https://alfajores-forno.celo-testnet.org
# For Mainnet:
RPC_URL_MAINNET=https://forno.celo.org
ACTIVE_CHAIN=mainnet

# Private Key for Contract Interactions
# ⚠️ NEVER commit this to version control
# Use environment variable or secrets manager
PRIVATE_KEY=0x...
VERIFIER_PRIVATE_KEY=0x...

# Smart Contract Addresses (deployed addresses)
FORGE_QUEST_MANAGER_ADDRESS=0x...
REPUTATION_ADDRESS=0x...
REWARD_NFT_ADDRESS=0x...
TREASURY_ADDRESS=0x...

# OpenAI API Key for Quest Generation
OPENAI_API_KEY=sk-...

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN_SECONDS=900

# Authentication Configuration
AUTH_STATEMENT=I consent to QuestForge AI accessing my account.
AUTH_NONCE_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=168

# Rate Limiting Configuration
# Global rate limit: 150 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Per-endpoint limits (requests per hour)
QUEST_GENERATION_RATE_LIMIT=50
PROOF_SUBMISSION_RATE_LIMIT=100

# Logging and Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://...@sentry.io/...

# Health Check Configuration
HEALTH_CHECK_INTERVAL_MS=60000

# Redis Configuration (optional, for production rate limiting)
REDIS_URL=redis://localhost:6379

# Indexer Configuration
INDEXER_POLL_INTERVAL_MS=10000
VERIFICATION_WORKER_INTERVAL_MS=5000
VERIFICATION_BATCH_SIZE=10

# Circuit Breaker Configuration
MAX_DAILY_REWARDS_CELO=10000
MAX_REWARD_POOL_SIZE_CELO=1000

# Email Configuration (for alerts)
ALERT_EMAIL=ops@questforge.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=password

# Deployment Information
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_ENV=production
DEPLOYMENT_TIMESTAMP=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
