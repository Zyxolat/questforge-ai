# QuestForge AI Production Environment Configuration
# IMPORTANT: This file should NEVER be committed to version control
# In production, use environment variable injection or secrets manager

# Node Environment
NODE_ENV=production

# API Configuration
PORT=4000
API_URL=https://api.questforge.example.com
FRONTEND_URL=https://questforge-ai.vercel.app

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://questforge_prod:secure_db_password_change_me@localhost:5432/questforge_prod
DB_POOL_SIZE=20

# Blockchain - Celo Network
RPC_URL_MAINNET=https://forno.celo.org
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Private Key for Contract Interactions (from secure secrets manager)
# ⚠️ NEVER commit this to version control
# Generate test key: npx ts-node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
PRIVATE_KEY=replace-with-funded-celo-private-key
VERIFIER_PRIVATE_KEY=replace-with-verifier-private-key

# Smart Contract Addresses (will be populated after deployment)
# These MUST be valid addresses after deployment
FORGE_QUEST_MANAGER_ADDRESS=0xYourForgeQuestManagerAddress
REPUTATION_ADDRESS=0xYourReputationAddress
REWARD_NFT_ADDRESS=0xYourRewardNFTAddress
TREASURY_ADDRESS=0xYourTreasuryAddress

# OpenAI API Key for Quest Generation
# Generate key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_for_production
JWT_EXPIRES_IN=15m

# Authentication Configuration
AUTH_STATEMENT=I consent to QuestForge AI accessing my account.
AUTH_NONCE_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=168
AUTH_DOMAIN=questforge-ai.vercel.app
AUTH_URI=https://questforge-ai.vercel.app
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=https://questforge-ai.vercel.app

# Rate Limiting Configuration
# Global rate limit: 150 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Per-endpoint limits (requests per hour)
QUEST_GENERATION_RATE_LIMIT=50
PROOF_SUBMISSION_RATE_LIMIT=100

# Logging and Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your_sentry_id@sentry.io/your_project_id

# Health Check Configuration
HEALTH_CHECK_INTERVAL_MS=60000

# Redis Configuration (for distributed rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Indexer Configuration
INDEXER_FROM_BLOCK=0
INDEXER_POLL_INTERVAL_MS=10000
VERIFICATION_WORKER_INTERVAL_MS=5000
VERIFICATION_BATCH_SIZE=10

# Circuit Breaker Configuration
MAX_DAILY_REWARDS_CELO=10000
MAX_REWARD_POOL_SIZE_CELO=1000

# Email Configuration (for alerts)
ALERT_EMAIL=ops@questforge.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=your_smtp_password

# Deployment Information
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_ENV=production
DEPLOYMENT_TIMESTAMP=2026-05-10T03:45:00Z
