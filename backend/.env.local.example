# Local backend environment for development and gameplay validation.
# Copy this file to backend/.env and fill in the database credentials.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string for your local database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/questforge

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# Celo mainnet RPC endpoint
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# Deployed contract addresses for Celo mainnet
FORGE_QUEST_MANAGER_ADDRESS=0xFDF8901BB33Bd52ef199F3d3E6647b8a1f86D2d2
REWARD_NFT_ADDRESS=0xc9539e553acC578d063A23B3F4f62C760356Cf6D
REPUTATION_ADDRESS=0x8aB46e0Bf56EC119DEfd8c279b75ce19E72B083c
TREASURY_ADDRESS=0xEdFdE2946D0D31a636CE115d0026Ce6096957D5B

# Local development options
ENABLE_EVENT_STREAM=false
WEBSOCKET_ENABLED=true
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:3000
AUTH_NONCE_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=168
AUTH_STATEMENT=Sign in to QuestForge AI.
AUTH_COOKIE_NAME=questforge_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Optional local dev settings
REDIS_URL=
VERIFIER_PRIVATE_KEY=
DAILY_REWARD_TREASURY_PRIVATE_KEY=
