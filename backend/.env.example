# ============================================================================
# QuestForge AI — Backend Environment Variables
# ============================================================================
#
# RAILWAY DEPLOYMENT: All variables marked [REQUIRED] MUST be set in the
# Railway dashboard (service → Variables) before deploying. The app validates
# these at startup and will crash with "Missing required environment variable"
# if any are absent, causing all healthchecks to fail.
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env to version control.
# ============================================================================

# ============================================================================
# Server
# ============================================================================
PORT=4000                        # Optional — defaults to 4000

# ============================================================================
# Database [REQUIRED]
# ============================================================================
# PostgreSQL connection string. On Railway, use the ${{Postgres.DATABASE_URL}}
# reference variable to link the Postgres plugin automatically.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/questforge

# ============================================================================
# Frontend & CORS [REQUIRED]
# ============================================================================
# The public URL of the deployed frontend (used for CORS and SIWE auth URIs).
# Must be an absolute URL including scheme, e.g. https://app.questforge.ai
FRONTEND_URL=https://questforge-ai.vercel.app

# Comma-separated list of allowed CORS origins. Must match FRONTEND_URL in
# production. Multiple origins: https://app.questforge.ai,https://www.questforge.ai
CORS_ORIGIN=https://questforge-ai.vercel.app

# ============================================================================
# Authentication [REQUIRED]
# ============================================================================
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Token lifetime. Accepts: 15m, 1h, 7d, or plain seconds (e.g. 900).
JWT_EXPIRES_IN=15m

# ============================================================================
# Blockchain — Celo [REQUIRED]
# ============================================================================
# RPC endpoint for Celo Mainnet. Public endpoint: https://forno.celo.org
# For production, use a dedicated node (Infura, Alchemy, Ankr, etc.)
CELO_RPC_URL=https://forno.celo.org
# CELO_NODE_URL=https://forno.celo.org  # Accepted as an alias for CELO_RPC_URL

# Must be 42220 (Celo Mainnet). The app rejects any other value.
CELO_CHAIN_ID=42220

# ============================================================================
# Smart Contract Addresses [REQUIRED]
# ============================================================================
# Deployed contract addresses on Celo Mainnet. Obtain these from the contract
# deployment step (see DEPLOYMENT_GUIDE.md → Smart Contract Deployment).
# All values must be valid checksummed Ethereum addresses (0x...).
FORGE_QUEST_MANAGER_ADDRESS=0xYourForgeQuestManagerAddress
REWARD_NFT_ADDRESS=0xYourRewardNFTAddress
REPUTATION_ADDRESS=0xYourReputationAddress
TREASURY_ADDRESS=0xYourTreasuryAddress

# ============================================================================
# Verifier / Signer [Optional but recommended for production]
# ============================================================================
# Private key of the wallet granted VERIFIER_ROLE on the contracts.
# Required only for on-chain quest verification and reward distribution.
VERIFIER_PRIVATE_KEY=
# PRIVATE_KEY=  # Accepted as an alias for VERIFIER_PRIVATE_KEY

# ============================================================================
# AI [Optional]
# ============================================================================
# Required for AI-powered quest generation. Leave blank to disable AI features.
OPENAI_API_KEY=

# ============================================================================
# Redis [Optional]
# ============================================================================
# Used for rate limiting and required for event streaming.
# If unset, rate limiting falls back to in-memory store.
# When ENABLE_EVENT_STREAM=true, this must point at a real Redis instance.
# On Railway, use the ${{Redis.REDIS_URL}} reference variable.
REDIS_URL=

# ============================================================================
# Auth / SIWE (Sign-In With Ethereum) [Optional — defaults shown]
# ============================================================================
AUTH_DOMAIN=questforge-ai.vercel.app
AUTH_URI=https://questforge-ai.vercel.app
AUTH_NONCE_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=168
AUTH_STATEMENT=Sign in to QuestForge AI.
AUTH_COOKIE_NAME=questforge_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=true         # Must be true in production (HTTPS required)
AUTH_COOKIE_SAME_SITE=none      # Must be none for cross-origin frontend/backend auth cookies
# AUTH_COOKIE_DOMAIN=.questforge.ai

# ============================================================================
# Indexer [Optional — defaults shown]
# ============================================================================
INDEXER_FROM_BLOCK=0
INDEXER_POLL_INTERVAL_MS=10000
VERIFICATION_WORKER_INTERVAL_MS=5000
VERIFICATION_BATCH_SIZE=10

# ============================================================================
# Real-Time Blockchain Event Streaming [Optional — defaults shown]
# Disabled by default so deployments can boot without Redis. Enable only after
# REDIS_URL is configured and you want the queue/worker/indexer stack online.
# ============================================================================
ENABLE_EVENT_STREAM=false

EVENT_CHUNK_SIZE=5000           # Number of blocks per RPC chunk request
EVENT_POLL_INTERVAL_MS=5000     # How often to poll for new events (milliseconds)

INDEXER_RETRY_LIMIT=10          # Max retries for RPC calls
INDEXER_BACKOFF_MS=2000         # Initial backoff time (exponential)

WEBSOCKET_ENABLED=true          # Enable Socket.IO for real-time frontend updates

RPC_TIMEOUT_MS=30000            # RPC call timeout (milliseconds)

EVENT_WORKER_CONCURRENCY=5      # Number of parallel event processors
